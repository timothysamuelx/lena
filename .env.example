# ─────────────────────────────────────────────────────────────
# Sanity — create a project at https://www.sanity.io/manage
# (or run `npx sanity@latest init --env` in this folder).
# Without these the site runs with built-in sample projects.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: a Viewer token (sanity.io/manage → API → Tokens).
# Enables draft previews + click-to-edit in the Presentation tool.
SANITY_API_READ_TOKEN=

# Public URL of the deployed site (used for metadata / sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
